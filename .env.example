# ═══════════════════════════════════════════════════════════════
# REQUIRED for Splunk API (fetch-splunk / dashboard fetch button)
# Same credentials as your curl: -u '<username>:<password>'
# ═══════════════════════════════════════════════════════════════
SPLUNK_USERNAME=your_adobe_email@adobe.com
SPLUNK_PASSWORD=your_adobe_password

# ═══════════════════════════════════════════════════════════════
# REQUIRED for Azure log archive (archive-azure)
# ═══════════════════════════════════════════════════════════════
AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ═══════════════════════════════════════════════════════════════
# REQUIRED for git commit ↔ execution correlation + module analysis
# (Cloud Manager → Repositories → Access Repo Info)
# ═══════════════════════════════════════════════════════════════
CM_GIT_REPO_URL=https://git.cloudmanager.adobe.com/idfc/idfc/
CM_GIT_USERNAME=your_username
CM_GIT_PASSWORD=your_generated_password
GIT_LOCAL_DIR=/Users/vanshika/idfc-repo

# ── Program & pipelines ───────────────────────────────────────
PROGRAM_ID=19905
PIPELINE_ID_PROD=2357452
PIPELINE_ID_DEV=47202398

# ── History ───────────────────────────────────────────────────
HISTORY_WINDOW_DAYS=0
AZURE_LOG_MAX_AGE_DAYS=15
MIN_PAIR_SAMPLES=3
SKIP_AZURE_LIVE=true

# ── Splunk API window ─────────────────────────────────────────
SPLUNK_EARLIEST=-90d
SPLUNK_LATEST=now

# ── Splunk CSV paths ──────────────────────────────────────────
SPLUNK_PIPELINES_CSV=data/splunk_exports/pipelines-list.csv
SPLUNK_FAILED_STEPS_CSV=data/splunk_exports/first-failed-steps.csv
SPLUNK_SHARE_NAMES_CSV=data/splunk_exports/share-names.csv

# ── Azure logs stored INSIDE this project (for vector DB + re-index)
# Do not delete after vector build — keep as source of truth
LOG_ARCHIVE_DIR=data/log_archive

# ── Index paths ───────────────────────────────────────────────
INDEX_DIR=data/index
VECTOR_PERSIST_DIR=data/index/vector_store
LOG_CACHE_DIR=data/log_cache

# ── Dual-track combine weights (enterprise gate) ───────────────
ENABLE_VECTOR_TRACK=true
TRACK_A_WEIGHT=0.6
TRACK_B_WEIGHT=0.4
VECTOR_TOP_K=8
EMBEDDING_MODEL=all-MiniLM-L6-v2
GIT_FETCH_TTL_MINUTES=10

# Point at your existing 30-day Azure files (or copy into data/log_archive/)
# Layout: {LOG_ARCHIVE_DIR}/{executionId}/build.log, securityTests.log, deploy/deploy.log
